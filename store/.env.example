# پیکربندی نمونه برای استقرار با Docker (docker-compose)
# کپی فایل .env.example در ریشه ریپو به نام .env و مقادیر را تنظیم کنید.

APP_NAME="فروشگاه من"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_PORT=8000

# دیتابیس MySQL 8.4
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=store
DB_USERNAME=store
DB_PASSWORD=store_secret
MYSQL_ROOT_PASSWORD=root_secret

# گذرواژه کاربر مدیر (admin@example.com)
ADMIN_PASSWORD=admin1234

# درگاه پرداخت ایرانی (برای اتصال واقعی تکمیل شود)
IRANIAN_GATEWAY_MERCHANT_ID=
IRANIAN_GATEWAY_URL=
ZARINPAL_MERCHANT_ID=
